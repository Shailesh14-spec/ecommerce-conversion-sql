// Revenue
Gross Revenue =
SUM(FactTransactions[GrossRevenueCents]) / 100

// Revenue
Cancellation Value =
SUM(FactTransactions[CancellationValueCents]) / 100

// Revenue
Net Revenue =
SUM(FactTransactions[NetRevenueCents]) / 100

// Quality
Revenue Reconciliation =
[Gross Revenue] - [Cancellation Value] - [Net Revenue]

// Orders
Positive Orders =
CALCULATE(DISTINCTCOUNT(FactTransactions[InvoiceNo]), FactTransactions[Quantity] > 0)

// Orders
Cancelled Invoices =
CALCULATE(DISTINCTCOUNT(FactTransactions[InvoiceNo]), FactTransactions[Quantity] < 0)

// Orders
Average Order Value =
DIVIDE([Gross Revenue], [Positive Orders])

// Orders
Sales Units =
SUM(FactTransactions[SalesUnits])

// Orders
Cancelled Units =
SUM(FactTransactions[CancelledUnits])

// Revenue
Cancellation Value Rate =
DIVIDE([Cancellation Value], [Gross Revenue])

// Customers
Known Customers =
CALCULATE(DISTINCTCOUNT(FactTransactions[CustomerKey]), FactTransactions[CustomerKey] <> 0, FactTransactions[Quantity] > 0)

// Customers
Anonymous Revenue =
CALCULATE([Gross Revenue], FactTransactions[CustomerKey] = 0)

// Customers
Anonymous Revenue Share =
DIVIDE([Anonymous Revenue], [Gross Revenue])

// Customers
Repeat Buyers =
COUNTROWS(FILTER(CALCULATETABLE(VALUES(DimCustomer[CustomerKey]), DimCustomer[CustomerKey] <> 0), CALCULATE([Positive Orders]) > 1))

// Customers
Repeat Buyer Share =
DIVIDE([Repeat Buyers], [Known Customers])

// Time intelligence
Net Revenue MTD =
TOTALMTD([Net Revenue], DimDate[Date])

// Time intelligence
Net Revenue Previous Month =
CALCULATE([Net Revenue], DATEADD(DimDate[Date], -1, MONTH))

// Time intelligence
Net Revenue MoM % =
DIVIDE([Net Revenue] - [Net Revenue Previous Month], [Net Revenue Previous Month])

// Time intelligence
Net Revenue Rolling 28D =
VAR EndDate = MAX(DimDate[Date]) RETURN CALCULATE([Net Revenue], DATESINPERIOD(DimDate[Date], EndDate, -28, DAY))

// Time intelligence
Complete Month Revenue =
CALCULATE([Net Revenue], DimDate[IsCompleteMonth] = TRUE())

// Products
Product Revenue Rank =
RANKX(ALLSELECTED(DimProduct[Description]), [Net Revenue], , DESC, DENSE)

// Products
Top 10 Product Revenue =
IF([Product Revenue Rank] <= 10, [Net Revenue])

// Products
Product Revenue Share =
DIVIDE([Net Revenue], CALCULATE([Net Revenue], ALLSELECTED(DimProduct)))

// Cohorts
Cohort Active Customers =
SUM(FactCohort[ActiveCustomers])

// Cohorts
Cohort Base Customers =
SUM(FactCohort[CohortCustomers])

// Cohorts
Cohort Retention % =
IF(HASONEVALUE(FactCohort[CohortMonth]) && HASONEVALUE(FactCohort[AgeMonth]), DIVIDE([Cohort Active Customers], [Cohort Base Customers]))

// Cohorts
Month 1 Retention % =
VAR Active = CALCULATE(SUM(FactCohort[ActiveCustomers]), FactCohort[AgeMonth] = 1) VAR Eligible = CALCULATE(SUM(FactCohort[CohortCustomers]), FactCohort[AgeMonth] = 1) RETURN DIVIDE(Active, Eligible)

// Forecast
Backtest Actual =
CALCULATE(SUM(FactForecast[ActualGBP]), FactForecast[SeriesType] = "Backtest")

// Forecast
Backtest Forecast =
CALCULATE(SUM(FactForecast[ForecastGBP]), FactForecast[SeriesType] = "Backtest")

// Forecast
Future Scenario Forecast =
CALCULATE(SUM(FactForecast[ForecastGBP]), FactForecast[SeriesType] = "Future scenario")

// Forecast
Forecast MAE =
AVERAGEX(FILTER(FactForecast, FactForecast[SeriesType] = "Backtest"), ABS(FactForecast[ActualGBP] - FactForecast[ForecastGBP]))

// Forecast
Baseline MAE =
AVERAGEX(FILTER(FactForecast, FactForecast[SeriesType] = "Backtest"), ABS(FactForecast[ActualGBP] - FactForecast[BaselineGBP]))

// Forecast
Forecast Improvement % =
1 - DIVIDE([Forecast MAE], [Baseline MAE])

// Hypothetical scenario
Selected Cost Ratio =
SELECTEDVALUE(CostScenario[CostRatio], 0.60)

// Hypothetical scenario
Scenario Contribution =
[Net Revenue] * (1 - [Selected Cost Ratio])

// Hypothetical scenario
Scenario Contribution Rate =
1 - [Selected Cost Ratio]

// Quality
Data Lines =
COUNTROWS(FactTransactions)
