{
  "name": "RetailIntelligence",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-GB",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-GB",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "expressions": [
      {
        "name": "SourceFolder",
        "kind": "m",
        "expression": "\"C:\\RetailIntelligence\\data\\model\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "FactTransactions",
        "columns": [
          {
            "name": "SourceRow",
            "dataType": "int64",
            "sourceColumn": "SourceRow",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "InvoiceNo",
            "dataType": "string",
            "sourceColumn": "InvoiceNo",
            "summarizeBy": "none"
          },
          {
            "name": "DateKey",
            "dataType": "int64",
            "sourceColumn": "DateKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "sourceColumn": "CustomerKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "CountryKey",
            "dataType": "int64",
            "sourceColumn": "CountryKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "ProductKey",
            "dataType": "int64",
            "sourceColumn": "ProductKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "sourceColumn": "Quantity",
            "summarizeBy": "sum"
          },
          {
            "name": "SalesUnits",
            "dataType": "int64",
            "sourceColumn": "SalesUnits",
            "summarizeBy": "sum"
          },
          {
            "name": "CancelledUnits",
            "dataType": "int64",
            "sourceColumn": "CancelledUnits",
            "summarizeBy": "sum"
          },
          {
            "name": "NetRevenueCents",
            "dataType": "int64",
            "sourceColumn": "NetRevenueCents",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "GrossRevenueCents",
            "dataType": "int64",
            "sourceColumn": "GrossRevenueCents",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "CancellationValueCents",
            "dataType": "int64",
            "sourceColumn": "CancellationValueCents",
            "summarizeBy": "sum",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "FactTransactions",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n Source = Csv.Document(File.Contents(SourceFolder & \"\\FactTransactions.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n Typed = Table.TransformColumnTypes(Headers, {{\"SourceRow\", Int64.Type}, {\"InvoiceNo\", type text}, {\"DateKey\", Int64.Type}, {\"CustomerKey\", Int64.Type}, {\"CountryKey\", Int64.Type}, {\"ProductKey\", Int64.Type}, {\"Quantity\", Int64.Type}, {\"SalesUnits\", Int64.Type}, {\"CancelledUnits\", Int64.Type}, {\"NetRevenueCents\", Int64.Type}, {\"GrossRevenueCents\", Int64.Type}, {\"CancellationValueCents\", Int64.Type}}, \"en-GB\")\nin Typed"
            }
          }
        ]
      },
      {
        "name": "DimDate",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "isKey": true,
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "DateKey",
            "dataType": "int64",
            "sourceColumn": "DateKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          },
          {
            "name": "MonthNumber",
            "dataType": "int64",
            "sourceColumn": "MonthNumber",
            "summarizeBy": "none"
          },
          {
            "name": "YearMonth",
            "dataType": "string",
            "sourceColumn": "YearMonth",
            "summarizeBy": "none",
            "sortByColumn": "MonthSort"
          },
          {
            "name": "MonthSort",
            "dataType": "int64",
            "sourceColumn": "MonthSort",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "IsCompleteMonth",
            "dataType": "boolean",
            "sourceColumn": "IsCompleteMonth",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n Source = Csv.Document(File.Contents(SourceFolder & \"\\DimDate.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n Typed = Table.TransformColumnTypes(Headers, {{\"Date\", type date}, {\"DateKey\", Int64.Type}, {\"Year\", Int64.Type}, {\"MonthNumber\", Int64.Type}, {\"YearMonth\", type text}, {\"MonthSort\", Int64.Type}, {\"IsCompleteMonth\", type logical}}, \"en-GB\")\nin Typed"
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "DimCountry",
        "columns": [
          {
            "name": "Country",
            "dataType": "string",
            "sourceColumn": "Country",
            "summarizeBy": "none"
          },
          {
            "name": "CountryKey",
            "dataType": "int64",
            "sourceColumn": "CountryKey",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "DimCountry",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n Source = Csv.Document(File.Contents(SourceFolder & \"\\DimCountry.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n Typed = Table.TransformColumnTypes(Headers, {{\"Country\", type text}, {\"CountryKey\", Int64.Type}}, \"en-GB\")\nin Typed"
            }
          }
        ]
      },
      {
        "name": "DimProduct",
        "columns": [
          {
            "name": "ProductKey",
            "dataType": "int64",
            "sourceColumn": "ProductKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "StockCode",
            "dataType": "string",
            "sourceColumn": "StockCode",
            "summarizeBy": "none"
          },
          {
            "name": "Description",
            "dataType": "string",
            "sourceColumn": "Description",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimProduct",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n Source = Csv.Document(File.Contents(SourceFolder & \"\\DimProduct.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n Typed = Table.TransformColumnTypes(Headers, {{\"ProductKey\", Int64.Type}, {\"StockCode\", type text}, {\"Description\", type text}}, \"en-GB\")\nin Typed"
            }
          }
        ]
      },
      {
        "name": "DimCustomer",
        "columns": [
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "sourceColumn": "CustomerKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Segment",
            "dataType": "string",
            "sourceColumn": "Segment",
            "summarizeBy": "none"
          },
          {
            "name": "RecencyDays",
            "dataType": "int64",
            "sourceColumn": "RecencyDays",
            "summarizeBy": "sum"
          },
          {
            "name": "Frequency",
            "dataType": "int64",
            "sourceColumn": "Frequency",
            "summarizeBy": "sum"
          },
          {
            "name": "MonetaryCents",
            "dataType": "int64",
            "sourceColumn": "MonetaryCents",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "AcquisitionMonth",
            "dataType": "string",
            "sourceColumn": "AcquisitionMonth",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimCustomer",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n Source = Csv.Document(File.Contents(SourceFolder & \"\\DimCustomer.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n Typed = Table.TransformColumnTypes(Headers, {{\"CustomerKey\", Int64.Type}, {\"Segment\", type text}, {\"RecencyDays\", Int64.Type}, {\"Frequency\", Int64.Type}, {\"MonetaryCents\", Int64.Type}, {\"AcquisitionMonth\", type text}}, \"en-GB\")\nin Typed"
            }
          }
        ]
      },
      {
        "name": "FactCohort",
        "columns": [
          {
            "name": "CohortMonth",
            "dataType": "string",
            "sourceColumn": "CohortMonth",
            "summarizeBy": "none"
          },
          {
            "name": "AgeMonth",
            "dataType": "int64",
            "sourceColumn": "AgeMonth",
            "summarizeBy": "none"
          },
          {
            "name": "ActiveCustomers",
            "dataType": "int64",
            "sourceColumn": "ActiveCustomers",
            "summarizeBy": "sum"
          },
          {
            "name": "CohortCustomers",
            "dataType": "int64",
            "sourceColumn": "CohortCustomers",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "FactCohort",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n Source = Csv.Document(File.Contents(SourceFolder & \"\\FactCohort.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n Typed = Table.TransformColumnTypes(Headers, {{\"CohortMonth\", type text}, {\"AgeMonth\", Int64.Type}, {\"ActiveCustomers\", Int64.Type}, {\"CohortCustomers\", Int64.Type}}, \"en-GB\")\nin Typed"
            }
          }
        ]
      },
      {
        "name": "FactForecast",
        "columns": [
          {
            "name": "ActualGBP",
            "dataType": "double",
            "sourceColumn": "ActualGBP",
            "summarizeBy": "sum",
            "formatString": "£#,0.00;(£#,0.00);£0.00"
          },
          {
            "name": "ForecastGBP",
            "dataType": "double",
            "sourceColumn": "ForecastGBP",
            "summarizeBy": "sum",
            "formatString": "£#,0.00;(£#,0.00);£0.00"
          },
          {
            "name": "BaselineGBP",
            "dataType": "double",
            "sourceColumn": "BaselineGBP",
            "summarizeBy": "sum",
            "formatString": "£#,0.00;(£#,0.00);£0.00"
          },
          {
            "name": "SeriesType",
            "dataType": "string",
            "sourceColumn": "SeriesType",
            "summarizeBy": "none"
          },
          {
            "name": "DateKey",
            "dataType": "int64",
            "sourceColumn": "DateKey",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "FactForecast",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n Source = Csv.Document(File.Contents(SourceFolder & \"\\FactForecast.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n Typed = Table.TransformColumnTypes(Headers, {{\"ActualGBP\", type number}, {\"ForecastGBP\", type number}, {\"BaselineGBP\", type number}, {\"SeriesType\", type text}, {\"DateKey\", Int64.Type}}, \"en-GB\")\nin Typed"
            }
          }
        ]
      },
      {
        "name": "CostScenario",
        "columns": [
          {
            "name": "CostRatio",
            "dataType": "double",
            "sourceColumn": "CostRatio",
            "summarizeBy": "sum",
            "formatString": "0%"
          }
        ],
        "partitions": [
          {
            "name": "CostScenario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n Source = Csv.Document(File.Contents(SourceFolder & \"\\CostScenario.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n Typed = Table.TransformColumnTypes(Headers, {{\"CostRatio\", type number}}, \"en-GB\")\nin Typed"
            }
          }
        ]
      },
      {
        "name": "Metrics",
        "columns": [
          {
            "name": "Placeholder",
            "dataType": "int64",
            "sourceColumn": "Placeholder",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Metrics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Placeholder = Int64.Type], {{1}})"
            }
          }
        ],
        "measures": [
          {
            "name": "Gross Revenue",
            "expression": "SUM(FactTransactions[GrossRevenueCents]) / 100",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Revenue",
            "description": ""
          },
          {
            "name": "Cancellation Value",
            "expression": "SUM(FactTransactions[CancellationValueCents]) / 100",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Revenue",
            "description": "Absolute value of negative retained lines. Not confirmed physical returns."
          },
          {
            "name": "Net Revenue",
            "expression": "SUM(FactTransactions[NetRevenueCents]) / 100",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Revenue",
            "description": ""
          },
          {
            "name": "Revenue Reconciliation",
            "expression": "[Gross Revenue] - [Cancellation Value] - [Net Revenue]",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Quality",
            "description": ""
          },
          {
            "name": "Positive Orders",
            "expression": "CALCULATE(DISTINCTCOUNT(FactTransactions[InvoiceNo]), FactTransactions[Quantity] > 0)",
            "formatString": "#,0",
            "displayFolder": "Orders",
            "description": ""
          },
          {
            "name": "Cancelled Invoices",
            "expression": "CALCULATE(DISTINCTCOUNT(FactTransactions[InvoiceNo]), FactTransactions[Quantity] < 0)",
            "formatString": "#,0",
            "displayFolder": "Orders",
            "description": ""
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Gross Revenue], [Positive Orders])",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Orders",
            "description": ""
          },
          {
            "name": "Sales Units",
            "expression": "SUM(FactTransactions[SalesUnits])",
            "formatString": "#,0",
            "displayFolder": "Orders",
            "description": ""
          },
          {
            "name": "Cancelled Units",
            "expression": "SUM(FactTransactions[CancelledUnits])",
            "formatString": "#,0",
            "displayFolder": "Orders",
            "description": ""
          },
          {
            "name": "Cancellation Value Rate",
            "expression": "DIVIDE([Cancellation Value], [Gross Revenue])",
            "formatString": "0.0%",
            "displayFolder": "Revenue",
            "description": "Period negative-line value divided by positive-line value. No invoice matching is implied."
          },
          {
            "name": "Known Customers",
            "expression": "CALCULATE(DISTINCTCOUNT(FactTransactions[CustomerKey]), FactTransactions[CustomerKey] <> 0, FactTransactions[Quantity] > 0)",
            "formatString": "#,0",
            "displayFolder": "Customers",
            "description": ""
          },
          {
            "name": "Anonymous Revenue",
            "expression": "CALCULATE([Gross Revenue], FactTransactions[CustomerKey] = 0)",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Customers",
            "description": ""
          },
          {
            "name": "Anonymous Revenue Share",
            "expression": "DIVIDE([Anonymous Revenue], [Gross Revenue])",
            "formatString": "0.0%",
            "displayFolder": "Customers",
            "description": ""
          },
          {
            "name": "Repeat Buyers",
            "expression": "COUNTROWS(FILTER(CALCULATETABLE(VALUES(DimCustomer[CustomerKey]), DimCustomer[CustomerKey] <> 0), CALCULATE([Positive Orders]) > 1))",
            "formatString": "#,0",
            "displayFolder": "Customers",
            "description": ""
          },
          {
            "name": "Repeat Buyer Share",
            "expression": "DIVIDE([Repeat Buyers], [Known Customers])",
            "formatString": "0.0%",
            "displayFolder": "Customers",
            "description": "Repeat in the current transaction filter context. Segment labels are a fixed end-of-data snapshot."
          },
          {
            "name": "Net Revenue MTD",
            "expression": "TOTALMTD([Net Revenue], DimDate[Date])",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Time intelligence",
            "description": ""
          },
          {
            "name": "Net Revenue Previous Month",
            "expression": "CALCULATE([Net Revenue], DATEADD(DimDate[Date], -1, MONTH))",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Time intelligence",
            "description": ""
          },
          {
            "name": "Net Revenue MoM %",
            "expression": "DIVIDE([Net Revenue] - [Net Revenue Previous Month], [Net Revenue Previous Month])",
            "formatString": "0.0%",
            "displayFolder": "Time intelligence",
            "description": "Use in a month-grain visual; final source month is partial."
          },
          {
            "name": "Net Revenue Rolling 28D",
            "expression": "VAR EndDate = MAX(DimDate[Date]) RETURN CALCULATE([Net Revenue], DATESINPERIOD(DimDate[Date], EndDate, -28, DAY))",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Time intelligence",
            "description": ""
          },
          {
            "name": "Complete Month Revenue",
            "expression": "CALCULATE([Net Revenue], DimDate[IsCompleteMonth] = TRUE())",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Time intelligence",
            "description": ""
          },
          {
            "name": "Product Revenue Rank",
            "expression": "RANKX(ALLSELECTED(DimProduct[Description]), [Net Revenue], , DESC, DENSE)",
            "formatString": "#,0",
            "displayFolder": "Products",
            "description": ""
          },
          {
            "name": "Top 10 Product Revenue",
            "expression": "IF([Product Revenue Rank] <= 10, [Net Revenue])",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Products",
            "description": ""
          },
          {
            "name": "Product Revenue Share",
            "expression": "DIVIDE([Net Revenue], CALCULATE([Net Revenue], ALLSELECTED(DimProduct)))",
            "formatString": "0.0%",
            "displayFolder": "Products",
            "description": ""
          },
          {
            "name": "Cohort Active Customers",
            "expression": "SUM(FactCohort[ActiveCustomers])",
            "formatString": "#,0",
            "displayFolder": "Cohorts",
            "description": ""
          },
          {
            "name": "Cohort Base Customers",
            "expression": "SUM(FactCohort[CohortCustomers])",
            "formatString": "#,0",
            "displayFolder": "Cohorts",
            "description": ""
          },
          {
            "name": "Cohort Retention %",
            "expression": "IF(HASONEVALUE(FactCohort[CohortMonth]) && HASONEVALUE(FactCohort[AgeMonth]), DIVIDE([Cohort Active Customers], [Cohort Base Customers]))",
            "formatString": "0.0%",
            "displayFolder": "Cohorts",
            "description": "Complete-month, known-customer active retention. Matrix totals intentionally blank."
          },
          {
            "name": "Month 1 Retention %",
            "expression": "VAR Active = CALCULATE(SUM(FactCohort[ActiveCustomers]), FactCohort[AgeMonth] = 1) VAR Eligible = CALCULATE(SUM(FactCohort[CohortCustomers]), FactCohort[AgeMonth] = 1) RETURN DIVIDE(Active, Eligible)",
            "formatString": "0.0%",
            "displayFolder": "Cohorts",
            "description": "Weighted month-1 retention across eligible cohorts; all countries and complete months only."
          },
          {
            "name": "Backtest Actual",
            "expression": "CALCULATE(SUM(FactForecast[ActualGBP]), FactForecast[SeriesType] = \"Backtest\")",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Forecast",
            "description": ""
          },
          {
            "name": "Backtest Forecast",
            "expression": "CALCULATE(SUM(FactForecast[ForecastGBP]), FactForecast[SeriesType] = \"Backtest\")",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Forecast",
            "description": ""
          },
          {
            "name": "Future Scenario Forecast",
            "expression": "CALCULATE(SUM(FactForecast[ForecastGBP]), FactForecast[SeriesType] = \"Future scenario\")",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Forecast",
            "description": "Historical-origin recursive scenario after the last complete source day, not a forecast of current business conditions."
          },
          {
            "name": "Forecast MAE",
            "expression": "AVERAGEX(FILTER(FactForecast, FactForecast[SeriesType] = \"Backtest\"), ABS(FactForecast[ActualGBP] - FactForecast[ForecastGBP]))",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Forecast",
            "description": ""
          },
          {
            "name": "Baseline MAE",
            "expression": "AVERAGEX(FILTER(FactForecast, FactForecast[SeriesType] = \"Backtest\"), ABS(FactForecast[ActualGBP] - FactForecast[BaselineGBP]))",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Forecast",
            "description": ""
          },
          {
            "name": "Forecast Improvement %",
            "expression": "1 - DIVIDE([Forecast MAE], [Baseline MAE])",
            "formatString": "0.0%",
            "displayFolder": "Forecast",
            "description": "Negative values mean the model is worse than the lag-7 baseline."
          },
          {
            "name": "Selected Cost Ratio",
            "expression": "SELECTEDVALUE(CostScenario[CostRatio], 0.60)",
            "formatString": "0.0%",
            "displayFolder": "Hypothetical scenario",
            "description": ""
          },
          {
            "name": "Scenario Contribution",
            "expression": "[Net Revenue] * (1 - [Selected Cost Ratio])",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "displayFolder": "Hypothetical scenario",
            "description": "Illustrative contribution only. No cost, margin or profit observations exist in the source."
          },
          {
            "name": "Scenario Contribution Rate",
            "expression": "1 - [Selected Cost Ratio]",
            "formatString": "0.0%",
            "displayFolder": "Hypothetical scenario",
            "description": ""
          },
          {
            "name": "Data Lines",
            "expression": "COUNTROWS(FactTransactions)",
            "formatString": "#,0",
            "displayFolder": "Quality",
            "description": ""
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "e24ef62e-d30d-51b0-9473-510b84f5bd38",
        "fromTable": "FactTransactions",
        "fromColumn": "DateKey",
        "toTable": "DimDate",
        "toColumn": "DateKey",
        "crossFilteringBehavior": "oneDirection",
        "fromCardinality": "many",
        "toCardinality": "one"
      },
