{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "topproducts",
  "position": {
    "x": 20,
    "y": 150,
    "width": 850,
    "height": 600,
    "z": 21,
    "tabOrder": 21
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimProduct"
                    }
                  },
                  "Property": "Description"
                }
              },
              "queryRef": "DimProduct.Description",
              "nativeQueryRef": "Description"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metrics"
                    }
                  },
                  "Property": "Top 10 Product Revenue"
                }
              },
              "queryRef": "Metrics.Top 10 Product Revenue",
              "nativeQueryRef": "Top 10 Product Revenue"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Top 10 product descriptions by net revenue'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "14D"
                }
              }
            }
          }
        }
      ]
    }
  }
}
