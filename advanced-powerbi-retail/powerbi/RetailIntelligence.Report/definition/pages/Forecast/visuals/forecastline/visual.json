{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "forecastline",
  "position": {
    "x": 20,
    "y": 150,
    "width": 1000,
    "height": 420,
    "z": 28,
    "tabOrder": 28
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimDate"
                    }
                  },
                  "Property": "Date"
                }
              },
              "queryRef": "DimDate.Date",
              "nativeQueryRef": "Date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metrics"
                    }
                  },
                  "Property": "Backtest Actual"
                }
              },
              "queryRef": "Metrics.Backtest Actual",
              "nativeQueryRef": "Backtest Actual"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metrics"
                    }
                  },
                  "Property": "Backtest Forecast"
                }
              },
              "queryRef": "Metrics.Backtest Forecast",
              "nativeQueryRef": "Backtest Forecast"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metrics"
                    }
                  },
                  "Property": "Future Scenario Forecast"
                }
              },
              "queryRef": "Metrics.Future Scenario Forecast",
              "nativeQueryRef": "Future Scenario Forecast"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'28-day test and recursive scenario (historical 2011 origin)'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "14D"
                }
              }
            }
          }
        }
      ]
    }
  }
}
