{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "segments",
  "position": {
    "x": 20,
    "y": 150,
    "width": 630,
    "height": 310,
    "z": 14,
    "tabOrder": 14
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimCustomer"
                    }
                  },
                  "Property": "Segment"
                }
              },
              "queryRef": "DimCustomer.Segment",
              "nativeQueryRef": "Segment"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metrics"
                    }
                  },
                  "Property": "Known Customers"
                }
              },
              "queryRef": "Metrics.Known Customers",
              "nativeQueryRef": "Known Customers"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'End-of-data customer segments'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "14D"
                }
              }
            }
          }
        }
      ]
    }
  }
}
